        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
            prepend rel material:binding:physics = </Instances/left_wheel_1_1/PhysicsMaterials/friction_left_right>
        }

        def Scope "PhysicsMaterials"
        {
            def Material "friction_left_right" (
                prepend references = @./materials.usda@</Materials/friction_left_right>
            )
            {
            }
