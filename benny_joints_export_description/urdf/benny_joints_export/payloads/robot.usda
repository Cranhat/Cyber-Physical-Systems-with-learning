#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2 (patched for Isaac Sim)"
    }
    defaultPrim = "benny_joints_export"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "benny_joints_export" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </benny_joints_export/Physics/left_wheel_joint>,
        </benny_joints_export/Physics/right_wheel_joint>,
        </benny_joints_export/Physics/front_caster_yaw_joint>,
        </benny_joints_export/Physics/front_caster_roll_joint>,
        </benny_joints_export/Physics/rear_caster_yaw_joint>,
        </benny_joints_export/Physics/rear_caster_roll_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </benny_joints_export/Geometry/base_link>,
        </benny_joints_export/Geometry/base_link/left_wheel_1>,
        </benny_joints_export/Geometry/base_link/right_wheel_1>,
        </benny_joints_export/Geometry/base_link/front_wheel_top_1>,
        </benny_joints_export/Geometry/base_link/front_wheel_top_1/front_wheel_bottom_1>,
        </benny_joints_export/Geometry/base_link/rear_wheel_top_1>,
        </benny_joints_export/Geometry/base_link/rear_wheel_top_1/rear_wheel_bottom_1>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "left_wheel_1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "right_wheel_1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "front_wheel_top_1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "front_wheel_bottom_1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "rear_wheel_top_1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rear_wheel_bottom_1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }
        }
    }

    over "Physics"
    {
        over "left_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_caster_yaw_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_caster_roll_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rear_caster_yaw_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rear_caster_roll_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}
